NODE_ENV=development
PORT=5000

# MongoDB connection string (provided by the workspace)
MONGO_URL=mongodb://localhost:27017/splitwise

# JWT
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# CORS - the origin of the Next.js frontend
CORS_ORIGIN=http://localhost:3000

# File uploads (receipts / attachments)
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Logging
LOG_LEVEL=info
